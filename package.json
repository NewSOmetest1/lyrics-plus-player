{
  "name": "lyrics-plus-player",
  "private": true,
  "version": "0.1.0",
  "description": "Lyrics+ — a karaoke-grade desktop music player for Linux",
  "author": "Lyrics+",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:lyrics": "node --experimental-strip-types scripts/test-providers.ts",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "colorthief": "^3.5.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^1.2.0"
  },
  "build": {
    "appId": "app.lyricsplus.player",
    "productName": "Lyrics+",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "lyrics-plus-player",
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
